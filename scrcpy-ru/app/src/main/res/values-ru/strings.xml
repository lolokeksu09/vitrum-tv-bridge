    <string name="text_234" formatted="false">"Локальный клиент ADB не открыл USB-подключение"</string>
    <string name="text_235" formatted="false">"USB закрыт"</string>
    <string name="text_236" formatted="false">"Неполная запись в USB: "</string>
    <string name="text_237" formatted="false">". Проверьте OTG-подключение и питание."</string>
    <string name="text_238" formatted="false">"Не удалось поставить чтение USB в очередь"</string>
    <string name="text_239" formatted="false">"Запрос USB отменён / кабель отключён"</string>
    <string name="text_240" formatted="false">"USB-подключение остановлено: "</string>
    <string name="text_241" formatted="false">"Максимальное разрешение • пикс."</string>
    <string name="text_242" formatted="false">"0 = исходный размер; для начала подойдёт 1280."</string>
    <string name="text_243" formatted="false">"Битрейт видео • бит/с"</string>
    <string name="text_244" formatted="false">"8 Мбит/с = 8000000. При слабом Wi-Fi попробуйте 2000000."</string>
    <string name="text_245" formatted="false">"Максимальная частота кадров (FPS)"</string>
    <string name="text_246" formatted="false">"30 / 60 / 90 / 120; фактическая частота зависит от B и подключения."</string>
    <string name="text_247" formatted="false">"Видеокодек"</string>
    <string name="text_248" formatted="false">"Источник видео"</string>
    <string name="text_249" formatted="false">"ID экрана"</string>
    <string name="text_250" formatted="false">"0 = основной экран. Список экранов доступен в меню сессии."</string>
    <string name="text_251" formatted="false">"Обрезка изображения"</string>
    <string name="text_252" formatted="false">"ширина:высота:x:y, например 1080:1920:0:0. Пусто = весь экран."</string>
    <string name="text_253" formatted="false">"Ориентация захвата"</string>
    <string name="text_254" formatted="false">"Пусто = авто; 0, 90, 180, 270; @0 фиксирует ориентацию."</string>
    <string name="text_255" formatted="false">"Угол видео"</string>
    <string name="text_256" formatted="false">"Поворот в градусах. Выполняется сервером, не меняет устройство A."</string>
    <string name="text_257" formatted="false">"Видеокодировщик"</string>
    <string name="text_258" formatted="false">"Пусто = автоматически; доступные названия есть в разделе «Кодировщики» меню сессии."</string>
    <string name="text_259" formatted="false">"Дополнительные параметры видеокодировщика"</string>
    <string name="text_260" formatted="false">"Пример: i-frame-interval=1. Значения MediaFormat: key[:type]=value."</string>
    <string name="text_261" formatted="false">"Звук с устройства B"</string>
    <string name="text_262" formatted="false">"Аудиокодек"</string>
    <string name="text_263" formatted="false">"Битрейт аудио • бит/с"</string>
    <string name="text_264" formatted="false">"Для AAC/Opus. RAW — без сжатия."</string>
    <string name="text_265" formatted="false">"Источник аудио"</string>
    <string name="text_266" formatted="false">"Продолжать воспроизведение звука на B"</string>
    <string name="text_267" formatted="false">"Аудиокодировщик"</string>
    <string name="text_268" formatted="false">"Пусто = автоматически."</string>
    <string name="text_269" formatted="false">"Дополнительные параметры аудиокодировщика"</string>
    <string name="text_270" formatted="false">"key[:type]=value. Дополнительный параметр; зависит от кодировщика."</string>
    <string name="text_271" formatted="false">"ID камеры"</string>
    <string name="text_272" formatted="false">"Пусто = автоматически. Доступно при захвате с камеры на Android 12+."</string>
    <string name="text_273" formatted="false">"Предпочтительная камера"</string>
    <string name="text_274" formatted="false">"Разрешение камеры"</string>
    <string name="text_275" formatted="false">"Пример: 1920x1080. Пусто = автоматически."</string>
    <string name="text_276" formatted="false">"Частота кадров камеры (FPS)"</string>
    <string name="text_277" formatted="false">"30 или 60, если поддерживается."</string>
    <string name="text_278" formatted="false">"Высокоскоростная камера"</string>
    <string name="text_279" formatted="false">"Виртуальный экран"</string>
    <string name="text_280" formatted="false">"Пусто = отключено; пример: 1280x720/240. Зависит от версии Android на B."</string>
    <string name="text_281" formatted="false">"Разрешить управление"</string>
    <string name="text_282" formatted="false">"Показывать касания на B"</string>
